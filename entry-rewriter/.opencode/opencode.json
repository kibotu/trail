{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy4-flash-free",
  "agent": {
    "entry-rewriter": {
      "description": "Rewrite a bookmark as one tweet-length note, informal Jake Wharton meets IT director - webfetch only",
      "mode": "subagent",
      "temperature": 0.7,
      "tools": {
        "webfetch": true,
        "bash": false,
        "read": false,
        "write": false,
        "edit": false,
        "patch": false,
        "list": false,
        "glob": false,
        "grep": false,
        "task": false,
        "todowrite": false,
        "todoread": false,
        "websearch": false,
        "codesearch": false
      }
    }
  }
}
